<div class="wrap">
  <div class="form-card">

    <div class="doc-head">
      <div class="brand-row">
        <div class="brand-mark">SW</div>
        <div>
          <div class="brand-name">SW MARKETING &amp; CONSULTING LLC</div>
          <div class="brand-tag">Field Service / Low-Voltage &amp; Telecom Support</div>
        </div>
      </div>
      <span class="role-pill">Applying for: IT / AV Field Technician</span>
      <h1>Field Provider Registration</h1>
      <p>Fill out this form and press <strong>Submit Application</strong>. Your completed form is turned into a PDF and an email to SW is set up for you. Approved providers will receive an invite email with account details, log-in information, and account verification steps.</p>
    </div>

    <form class="doc-body" id="regForm" novalidate autocomplete="on">

      <!-- CONTACT -->
      <div class="sec">
        <div class="sec-title">Contact Information</div>
        <div class="row c2">
          <div class="fg">
            <label class="fl" for="firstName">First name <span class="req">*</span></label>
            <input type="text" id="firstName" maxlength="60" autocomplete="given-name">
            <span class="ferr" id="firstName-err">Enter your first name.</span>
          </div>
          <div class="fg">
            <label class="fl" for="lastName">Last name <span class="req">*</span></label>
            <input type="text" id="lastName" maxlength="60" autocomplete="family-name">
            <span class="ferr" id="lastName-err">Enter your last name.</span>
          </div>
        </div>
        <div class="row phone">
          <div class="fg">
            <label class="fl" for="email">Email <span class="req">*</span></label>
            <input type="email" id="email" maxlength="120" autocomplete="email" placeholder="you@example.com">
            <span class="ferr" id="email-err">Enter a valid email.</span>
          </div>
          <div class="fg">
            <label class="fl" for="phoneCountry">Phone – country/region</label>
            <select id="phoneCountry">
              <option value="United States (+1)" selected>United States (+1)</option>
              <option value="Canada (+1)">Canada (+1)</option>
              <option value="Mexico (+52)">Mexico (+52)</option>
              <option value="Puerto Rico (+1)">Puerto Rico (+1)</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="fg">
            <label class="fl" for="phone">Phone number <span class="req">*</span></label>
            <input type="tel" id="phone" maxlength="20" autocomplete="tel-national" placeholder="(555) 000-0000">
            <span class="ferr" id="phone-err">Enter a valid phone number.</span>
          </div>
        </div>
      </div>

      <!-- ADDRESS -->
      <div class="sec">
        <div class="sec-title">Address</div>
        <div class="fg">
          <label class="fl" for="addr1">Address line 1 <span class="req">*</span></label>
          <input type="text" id="addr1" maxlength="120" autocomplete="address-line1">
          <span class="ferr" id="addr1-err">Enter your street address.</span>
        </div>
        <div class="fg">
          <label class="fl" for="addr2">Address line 2 <span class="opt">(optional)</span></label>
          <input type="text" id="addr2" maxlength="120" autocomplete="address-line2">
        </div>
        <div class="row c3">
          <div class="fg">
            <label class="fl" for="city">City <span class="req">*</span></label>
            <input type="text" id="city" maxlength="60" autocomplete="address-level2">
            <span class="ferr" id="city-err">Enter your city.</span>
          </div>
          <div class="fg">
            <label class="fl" for="state">State <span class="req">*</span></label>
            <input type="text" id="state" maxlength="40" autocomplete="address-level1" placeholder="AZ">
            <span class="ferr" id="state-err">Enter your state.</span>
          </div>
          <div class="fg">
            <label class="fl" for="zip">Zip code <span class="req">*</span></label>
            <input type="text" id="zip" maxlength="10" autocomplete="postal-code" inputmode="numeric">
            <span class="ferr" id="zip-err">Enter your zip code.</span>
          </div>
        </div>
        <div class="row c2">
          <div class="fg">
            <label class="fl" for="country">Country</label>
            <select id="country" autocomplete="country-name">
              <option selected>United States</option>
              <option>Canada</option>
              <option>Mexico</option>
              <option>Puerto Rico</option>
              <option>Other</option>
            </select>
          </div>
        </div>
      </div>

      <!-- TYPES OF WORK -->
      <div class="sec">
        <div class="sec-title">Types of Work <span class="req">*</span></div>
        <div class="sec-hint">Check all that apply.</div>
        <div class="check-grid" id="typesGrid"></div>
        <span class="ferr" id="types-err">Select at least one type of work.</span>
      </div>

      <!-- BIO -->
      <div class="sec">
        <div class="sec-title">Bio</div>
        <div class="sec-hint">A short summary of your experience and background.</div>
        <div class="fg">
          <textarea id="bio" maxlength="2000" placeholder="Years in the field, types of sites you've worked (retail, restaurant, office…), certifications, platforms you've used (Field Nation, WorkMarket, etc.)"></textarea>
        </div>
      </div>

      <!-- SKILLS -->
      <div class="sec">
        <div class="sec-title">Skills</div>
        <div class="sec-hint">Check every skill you can perform.</div>
        <div class="skills-cols" id="skillsWrap"></div>
      </div>

      <div class="submit-bar">
        <div class="msg" id="formMsg"></div>
        <button type="submit" class="submit-btn" id="submitBtn">Submit Application</button>
        <div class="submit-note">Submitting creates a PDF of your completed form and opens an email from your account to <strong>swmarketingfirm@gmail.com</strong>.</div>
      </div>
    </form>

    <div class="doc-foot">
      SW Marketing &amp; Consulting LLC &nbsp;|&nbsp; Phoenix, AZ<br>
      <a href="mailto:info@swmarketingfirm.com">info@swmarketingfirm.com</a> · <a href="mailto:swmarketingfirm@gmail.com">swmarketingfirm@gmail.com</a> · swmarketingfirm.com
    </div>
  </div>
</div>

<!-- SEND MODAL -->
<div class="overlay" id="sendOverlay" role="dialog" aria-modal="true" aria-labelledby="sendTitle">
  <div class="glass">
    <button class="close-btn" id="sendClose" aria-label="Close">✕</button>
    <div class="ico">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M22 6l-10 7L2 6"/></svg>
    </div>
    <h2 id="sendTitle">Send Your <span>Application</span></h2>
    <p class="lead" id="sendLead">Your completed form has been saved as a PDF and your email is set up. Send it to finish applying.</p>

    <div class="send-meta">
      <div><b>To</b> swmarketingfirm@gmail.com</div>
      <div><b>Subject</b> <span id="metaSubject"></span></div>
      <div><b>Attach</b> <span id="metaFile"></span></div>
    </div>

    <div class="attach-step" id="attachStep">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
      <span>Web browsers can't attach files to an email automatically. Your PDF was downloaded — attach it from your <strong>Downloads</strong> folder before you hit send.</span>
    </div>

    <div class="btn-stack">
      <button class="btn primary" id="shareBtn" type="button" style="display:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
        Email with PDF Attached
      </button>
      <a class="btn primary" id="mailtoBtn" href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M22 6l-10 7L2 6"/></svg>
        Open in My Email App
      </a>
      <div class="btn-row">
        <a class="btn ghost" id="gmailBtn" href="#" target="_blank" rel="noopener">Open in Gmail</a>
        <a class="btn ghost" id="outlookBtn" href="#" target="_blank" rel="noopener">Open in Outlook</a>
      </div>
      <button class="btn ghost" id="downloadBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download PDF Again
      </button>
    </div>
  </div>
</div>

<script>
/* ───────── CONFIG ───────── */
const TO_EMAIL = 'swmarketingfirm@gmail.com';
const ROLE = 'IT / AV Field Technician';

/* Types of work → skills (mirrors the Field Provider Registration PDF) */
const CATALOG = [
  ['Access & Alarms',       ['Access Control', 'Burglar Alarm', 'Fire Alarm', 'General Alarm']],
  ['A/V & Digital Signage', ['Audio Visual', 'Digital Signage', 'Satellite TV']],
  ['Cameras',               ['CCTV Camera', 'IP Camera']],
  ['EV Equipment',          ['EV Charging Stations']],
  ['Fiber Cabling',         ['Fiber Certification', 'Fiber Patch Cabling', 'Fiber Runs', 'Fiber Structured Cabling', 'Fiber Testing']],
  ['Kiosk / ATM',           ['ATM', 'Kiosk', 'Lockers']],
  ['Low Voltage Cabling',   ['Low Voltage Certification', 'Low Voltage Patch Cabling', 'Low Voltage Runs', 'Low Voltage Structured Cabling', 'Low Voltage Testing']],
  ['Office Equipment',      ['Copier', 'Mac Device', 'Printer', 'Windows Device']],
  ['Other',                 ['Electrical', 'Furniture', 'General Tasks', 'Other Trades']],
  ['Point of Sale',         ['Point of Sale', 'Self-Checkout']],
  ['Retail Services',       ['Advertising', 'Fixtures', 'Merchandising']],
  ['Server & Networking',   ['Networking', 'Satellite Networking', 'Server/Storage', 'Wireless Networking']],
  ['Telecom',               ['POTS', 'VoIP-SIP']],
];

/* ───────── SIDE MENU ───────── */
document.getElementById('hamburger').addEventListener('click', () => document.body.classList.toggle('menu-open'));
document.getElementById('sideMenuOverlay').addEventListener('click', () => document.body.classList.remove('menu-open'));

/* ───────── BUILD CHECKBOXES ───────── */
const typesGrid = document.getElementById('typesGrid');
const skillsWrap = document.getElementById('skillsWrap');
const slug = s => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

function makeChk(value, name, groupIdx) {
  const lbl = document.createElement('label');
  lbl.className = 'chk';
  const inp = document.createElement('input');
  inp.type = 'checkbox'; inp.name = name; inp.value = value; inp.dataset.group = groupIdx;
  const sp = document.createElement('span'); sp.textContent = value;
  lbl.append(inp, sp);
  inp.addEventListener('change', () => lbl.classList.toggle('on', inp.checked));
  return lbl;
}

CATALOG.forEach(([type, skills], i) => {
  typesGrid.appendChild(makeChk(type, 'type', i));

  const g = document.createElement('div');
  g.className = 'skill-group'; g.id = 'grp-' + i;
  const h = document.createElement('h4'); h.textContent = type;
  const grid = document.createElement('div'); grid.className = 'check-grid c2';
  skills.forEach(s => grid.appendChild(makeChk(s, 'skill', i)));
  g.append(h, grid);
  skillsWrap.appendChild(g);
});

/* Checking a skill auto-checks its Type of Work; highlight groups for checked types */
function syncGroups() {
  document.querySelectorAll('input[name=type]').forEach(t => {
    document.getElementById('grp-' + t.dataset.group).classList.toggle('active', t.checked);
  });
}
document.addEventListener('change', e => {
  const el = e.target;
  if (el.name === 'skill' && el.checked) {
    const t = document.querySelector(`input[name=type][data-group="${el.dataset.group}"]`);
    if (t && !t.checked) { t.checked = true; t.closest('.chk').classList.add('on'); }
  }
  if (el.name === 'type' || el.name === 'skill') {
    syncGroups();
    if (document.querySelector('input[name=type]:checked')) {
      typesGrid.classList.remove('error'); document.getElementById('types-err').classList.remove('show');
    }
  }
});

/* ───────── HELPERS ───────── */
const $ = id => document.getElementById(id);
const val = id => ($(id).value || '').trim();
const isEmail = e => /^[^\s@<>'"]{1,64}@[^\s@<>'"]{1,255}\.[a-zA-Z]{2,}$/.test(e);
const isPhone = p => /^[\d\s\+\-\(\)\.]{7,20}$/.test(p);
const checked = name => [...document.querySelectorAll(`input[name=${name}]:checked`)].map(i => i.value);

function collect() {
  const skillsByType = CATALOG.map(([type, skills], i) => ({
    type, all: skills,
    picked: [...document.querySelectorAll(`input[name=skill][data-group="${i}"]:checked`)].map(x => x.value)
  }));
  return {
    first: val('firstName'), last: val('lastName'),
    email: val('email'), phoneCountry: $('phoneCountry').value, phone: val('phone'),
    addr1: val('addr1'), addr2: val('addr2'), city: val('city'), state: val('state'), zip: val('zip'),
    country: $('country').value,
    types: checked('type'), bio: val('bio'), skillsByType,
    submitted: new Date()
  };
}

function validate() {
  const rules = [
    ['firstName', v => !!v], ['lastName', v => !!v],
    ['email', isEmail], ['phone', isPhone],
    ['addr1', v => !!v], ['city', v => !!v], ['state', v => !!v], ['zip', v => /^[A-Za-z0-9\- ]{3,10}$/.test(v)],
  ];
  let ok = true, first = null;
  rules.forEach(([id, test]) => {
    const good = test(val(id));
    $(id).classList.toggle('error', !good);
    $(id + '-err').classList.toggle('show', !good);
    if (!good) { ok = false; first = first || $(id); }
  });
  if (!checked('type').length) {
    ok = false; typesGrid.classList.add('error'); $('types-err').classList.add('show');
    first = first || typesGrid;
  }
  if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
  return ok;
}
['firstName','lastName','email','phone','addr1','city','state','zip'].forEach(id => {
  $(id).addEventListener('input', () => { $(id).classList.remove('error'); $(id + '-err').classList.remove('show'); });
});

/* ───────── PDF GENERATION (mirrors the paper form) ───────── */
function buildPdf(d) {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'letter' });
  const W = doc.internal.pageSize.getWidth(), H = doc.internal.pageSize.getHeight();
  const M = 48, CW = W - M * 2;
  const GREEN = [31, 122, 44], FILL = [233, 238, 250], GRAY = [110, 110, 110], DARK = [20, 20, 20];
  let y = 0, page = 1;

  function header(cont) {
    doc.setFont('helvetica', 'bolditalic'); doc.setFontSize(30); doc.setTextColor(...GREEN);
    doc.text('SW', M, 62);
    doc.setFont('helvetica', 'bold'); doc.setFontSize(13); doc.setTextColor(...DARK);
    doc.text('SW MARKETING & CONSULTING LLC', M + 58, 50);
    doc.setFont('helvetica', 'italic'); doc.setFontSize(9); doc.setTextColor(...GRAY);
    doc.text(cont ? 'Field Provider Registration — continued' : 'Field Service / Low-Voltage & Telecom Support', M + 58, 63);
    y = 88;
  }
  function footer() {
    doc.setDrawColor(...GREEN); doc.setLineWidth(1); doc.line(M, H - 50, W - M, H - 50);
    doc.setFont('helvetica', 'normal'); doc.setFontSize(8); doc.setTextColor(...GRAY);
    doc.text('SW Marketing & Consulting LLC  |  Phoenix, AZ', W / 2, H - 37, { align: 'center' });
    doc.text('info@swmarketingfirm.com  ·  swmarketingfirm@gmail.com  ·  swmarketingfirm.com', W / 2, H - 26, { align: 'center' });
    doc.text('Page ' + page, W - M, H - 26, { align: 'right' });
  }
  function need(h) {
    if (y + h > H - 64) { footer(); doc.addPage(); page++; header(true); }
  }
  function section(title) {
    need(40);
    y += 10;
    doc.setFont('helvetica', 'bold'); doc.setFontSize(12.5); doc.setTextColor(...GREEN);
    doc.text(title, M, y);
    y += 6; doc.setDrawColor(200, 200, 200); doc.setLineWidth(0.6); doc.line(M, y, W - M, y);
    y += 14;
  }
  function field(label, value, x, w) {
    doc.setFont('helvetica', 'normal'); doc.setFontSize(8); doc.setTextColor(...GRAY);
    doc.text(label, x, y);
    doc.setFillColor(...FILL); doc.rect(x, y + 4, w, 18, 'F');
    doc.setFontSize(10); doc.setTextColor(...DARK);
    const t = doc.splitTextToSize(value || '', w - 8)[0] || '';
    doc.text(t, x + 4, y + 16.5);
  }
  function fieldRow(items) {  // items: [label, value, fraction]
    need(36);
    const gap = 12; let x = M;
    const total = CW - gap * (items.length - 1);
    items.forEach(([l, v, f]) => { const w = total * f; field(l, v, x, w); x += w + gap; });
    y += 34;
  }
  function checkbox(x, yy, on, label) {
    doc.setDrawColor(on ? GREEN[0] : 170, on ? GREEN[1] : 170, on ? GREEN[2] : 170);
    doc.setLineWidth(0.8);
    if (on) { doc.setFillColor(...GREEN); doc.rect(x, yy - 8, 9, 9, 'FD');
      doc.setDrawColor(255, 255, 255); doc.setLineWidth(1.3);
      doc.line(x + 2, yy - 3.5, x + 4, yy - 1.2); doc.line(x + 4, yy - 1.2, x + 7.5, yy - 6);
    } else { doc.setFillColor(...FILL); doc.rect(x, yy - 8, 9, 9, 'F'); }
    doc.setFont('helvetica', on ? 'bold' : 'normal'); doc.setFontSize(9.5);
    doc.setTextColor(...(on ? DARK : [90, 90, 90]));
    doc.text(label, x + 15, yy);
  }
  function checkGrid(options, selected, cols) {
    const colW = CW / cols;
    for (let i = 0; i < options.length; i += cols) {
      need(16);
      options.slice(i, i + cols).forEach((o, j) => checkbox(M + 4 + j * colW, y, selected.includes(o), o));
      y += 15;
    }
  }

  /* Page 1 */
  header(false);
  doc.setFont('helvetica', 'bold'); doc.setFontSize(20); doc.setTextColor(...DARK);
  doc.text('Field Provider Registration', M, y + 6); y += 22;
  doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(...GRAY);
  doc.text('Position applied for: ' + ROLE, M, y); y += 12;
  doc.text('Submitted: ' + d.submitted.toLocaleString('en-US', { dateStyle: 'long', timeStyle: 'short' }), M, y); y += 8;
  doc.setDrawColor(...GREEN); doc.setLineWidth(1.2); doc.line(M, y, W - M, y); y += 8;

  section('Contact Information');
  fieldRow([['First name', d.first, .5], ['Last name', d.last, .5]]);
  fieldRow([['Email', d.email, .46], ['Phone – country/region', d.phoneCountry, .27], ['Phone number', d.phone, .27]]);

  section('Address');
  fieldRow([['Address line 1', d.addr1, 1]]);
  fieldRow([['Address line 2 – optional', d.addr2, 1]]);
  fieldRow([['City', d.city, .34], ['State', d.state, .33], ['Zip code', d.zip, .33]]);
  fieldRow([['Country', d.country, .4]]);

  section('Types of Work');
  checkGrid(CATALOG.map(c => c[0]), d.types, 3);

  section('Bio');
  doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
  const bioLines = doc.splitTextToSize(d.bio || '—', CW - 16);
  let bi = 0;
  while (bi < bioLines.length || bi === 0) {
    need(40);
    const room = Math.max(1, Math.floor((H - 64 - y - 12) / 13));
    const chunk = bioLines.slice(bi, bi + room);
    const boxH = Math.max(chunk.length * 13 + 14, 60);
    doc.setFillColor(...FILL); doc.rect(M, y, CW, boxH, 'F');
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(...DARK);
    doc.text(chunk, M + 8, y + 16);
    y += boxH + 6; bi += chunk.length;
    if (bi >= bioLines.length) break;
  }

  /* Skills */
  footer(); doc.addPage(); page++; header(true);
  section('Skills');
  d.skillsByType.forEach(g => {
    need(34);
    doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.setTextColor(...(g.picked.length ? GREEN : DARK));
    doc.text(g.type, M, y); y += 14;
    checkGrid(g.all, g.picked, 2);
    y += 4;
  });

  footer();
  return doc;
}

/* ───────── EMAIL HAND-OFF ───────── */
let pdfBlob = null, pdfName = '', subject = '', bodyText = '';

function emailBody(d) {
  const lines = [
    'Hello SW Marketing & Consulting,',
    '',
    `Please find my completed Field Provider Registration attached for the ${ROLE} position.`,
    '',
    `Name: ${d.first} ${d.last}`,
    `Email: ${d.email}`,
    `Phone: ${d.phoneCountry.replace(/ \(.*\)/, '')} ${d.phone}`,
    `Location: ${d.city}, ${d.state} ${d.zip}`,
    `Types of work: ${d.types.join(', ')}`,
  ];
  const picked = d.skillsByType.flatMap(g => g.picked);
  if (picked.length) lines.push(`Skills: ${picked.join(', ')}`);
  lines.push('', `Attachment: ${pdfName}`, '', 'Thank you,', `${d.first} ${d.last}`);
  return lines.join('\n');
}

function links() {
  const s = encodeURIComponent(subject), b = encodeURIComponent(bodyText), to = encodeURIComponent(TO_EMAIL);
  return {
    mailto: `mailto:${TO_EMAIL}?subject=${s}&body=${b}`,
    gmail: `https://mail.google.com/mail/?view=cm&fs=1&to=${to}&su=${s}&body=${b}`,
    outlook: `https://outlook.live.com/mail/0/deeplink/compose?to=${to}&subject=${s}&body=${b}`,
  };
}

function downloadPdf() {
  const url = URL.createObjectURL(pdfBlob);
  const a = document.createElement('a');
  a.href = url; a.download = pdfName; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 4000);
}

function canShareFile() {
  try {
    const f = new File([pdfBlob], pdfName, { type: 'application/pdf' });
    return !!(navigator.canShare && navigator.canShare({ files: [f] }));
  } catch { return false; }
}
const isTouch = window.matchMedia('(pointer: coarse)').matches;

async function sharePdf() {
  const f = new File([pdfBlob], pdfName, { type: 'application/pdf' });
  try {
    await navigator.share({ files: [f], title: subject, text: `To: ${TO_EMAIL}\nSubject: ${subject}\n\n${bodyText}` });
  } catch (e) { /* user cancelled share sheet */ }
}

function openSendModal(shareMode) {
  const L = links();
  $('metaSubject').textContent = subject;
  $('metaFile').textContent = pdfName;
  $('mailtoBtn').href = L.mailto;
  $('gmailBtn').href = L.gmail;
  $('outlookBtn').href = L.outlook;
  $('shareBtn').style.display = shareMode ? '' : 'none';
  $('attachStep').style.display = shareMode ? 'none' : '';
  $('sendLead').textContent = shareMode
    ? 'Your completed form is ready as a PDF. Tap "Email with PDF Attached", pick your Mail app, and send it to the address below.'
    : 'Your completed form has been saved as a PDF and your email is set up. Attach the PDF and send to finish applying.';
  $('sendOverlay').classList.add('show');
}
$('sendClose').addEventListener('click', () => $('sendOverlay').classList.remove('show'));
$('sendOverlay').addEventListener('click', e => { if (e.target.id === 'sendOverlay') $('sendOverlay').classList.remove('show'); });
$('shareBtn').addEventListener('click', sharePdf);
$('downloadBtn').addEventListener('click', downloadPdf);

/* ───────── SUBMIT ───────── */
$('regForm').addEventListener('submit', async e => {
  e.preventDefault();
  $('formMsg').classList.remove('show');
  if (!validate()) {
    $('formMsg').textContent = 'Please complete the required fields highlighted above.';
    $('formMsg').classList.add('show');
    return;
  }
  if (!window.jspdf) {
    $('formMsg').textContent = 'The PDF tool did not load. Check your connection and reload the page.';
    $('formMsg').classList.add('show');
    return;
  }

  const d = collect();
  const fullName = `${d.first} ${d.last}`.replace(/\s+/g, ' ').trim();
  subject = `${fullName} - Application`;
  pdfName = `${fullName.replace(/[^A-Za-z0-9 .'-]/g, '')} - Application.pdf`;
  pdfBlob = buildPdf(d).output('blob');
  bodyText = emailBody(d);

  const shareMode = isTouch && canShareFile();
  openSendModal(shareMode);

  if (shareMode) {
    // Phones/tablets: share sheet → Mail app with the PDF already attached
    sharePdf();
  } else {
    // Desktop: save the PDF, then open the person's email app with To/Subject/Body filled in
    downloadPdf();
    setTimeout(() => { window.location.href = links().mailto; }, 600);
  }
});
</script>
</body>
</html>
