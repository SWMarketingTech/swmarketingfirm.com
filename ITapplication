<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net;">
<meta name="referrer" content="no-referrer">
<title>SW — IT / AV Technician Application</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Syne:wght@400;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --green: hsl(130, 60%, 30%);
    --green-light: hsl(130, 55%, 38%);
    --bg: #f5f7f4;
    --dark: #111;
    --gray: #777;
  }
  html, body { min-height: 100%; font-family: 'Syne', sans-serif; background: var(--bg); color: var(--dark); }
  body { overflow-x: hidden; }

  /* Top bar */
  .topbar {
    position: sticky; top: 0; z-index: 40;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.1rem 2rem;
    background: rgba(245,247,244,0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .topbar-left { display: flex; align-items: center; gap: 0.85rem; }
  .topbar-logo {
    font-family: Impact, sans-serif; font-style: italic; font-size: 1.9rem;
    color: hsl(130,60%,32%); letter-spacing: -0.01em; user-select: none; cursor: pointer; text-decoration: none;
  }
  .back-link {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--dark); text-decoration: none;
    border: 1.5px solid rgba(0,0,0,0.14); border-radius: 3px; padding: 0.5rem 1rem;
    background: rgba(255,255,255,0.8); transition: all 0.3s ease;
  }
  .back-link:hover { background: var(--green); border-color: var(--green); color: #fff; }

  /* Hamburger + side menu */
  .hamburger {
    width: 38px; height: 38px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    background: transparent; border: 1.5px solid rgba(0,0,0,0.12);
    border-radius: 6px; cursor: pointer; flex-shrink: 0; transition: border-color 0.3s ease;
  }
  .hamburger:hover { border-color: var(--green); }
  .hamburger span { display: block; width: 18px; height: 2px; background: var(--dark); border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease; }
  body.menu-open .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  body.menu-open .hamburger span:nth-child(2) { opacity: 0; }
  body.menu-open .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .side-menu-overlay { position: fixed; inset: 0; z-index: 65; background: rgba(0,0,0,0.35);
    opacity: 0; pointer-events: none; transition: opacity 0.4s ease; }
  body.menu-open .side-menu-overlay { opacity: 1; pointer-events: all; }
  .side-menu { position: fixed; top: 0; left: 0; bottom: 0; z-index: 66; width: min(300px, 82vw);
    background: #fff; box-shadow: 4px 0 30px rgba(0,0,0,0.12); transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.7,0,0.3,1); display: flex; flex-direction: column; padding: 5rem 0 2rem; }
  body.menu-open .side-menu { transform: translateX(0); }
  .side-menu-brand { font-family: Impact, sans-serif; font-style: italic; font-size: 2.2rem;
    color: hsl(130,60%,32%); padding: 0 2rem 1.4rem; user-select: none; }
  .side-menu-links { display: flex; flex-direction: column; }
  .side-menu-link { display: flex; align-items: center; gap: 0.9rem; padding: 1rem 2rem;
    font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.92rem; letter-spacing: 0.06em;
    color: var(--dark); text-decoration: none; transition: background 0.2s ease, color 0.2s ease, padding-left 0.2s ease; }
  .side-menu-link:hover { background: rgba(34,139,34,0.07); color: var(--green); padding-left: 2.4rem; }
  .side-menu-link svg { width: 18px; height: 18px; stroke: currentColor; flex-shrink: 0; }
  .side-menu-link .ext { margin-left: auto; font-size: 0.6rem; color: #aaa; letter-spacing: 0.1em; text-transform: uppercase; }
  .side-menu-link.current { color: var(--green); background: rgba(34,139,34,0.06); }
  .side-menu-foot { margin-top: auto; padding: 1.2rem 2rem 0; font-family: 'Cormorant Garamond', serif;
    font-size: 0.82rem; color: var(--gray); border-top: 1px solid rgba(0,0,0,0.06); }

  /* Page */
  .wrap { max-width: 860px; margin: 0 auto; padding: 2.6rem clamp(1rem, 5vw, 3rem) 4rem; }
  .form-card {
    background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.05); overflow: hidden;
  }

  .doc-head { padding: 2rem 2.2rem 1.5rem; border-bottom: 2px solid var(--green); }
  .brand-row { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 1.2rem; }
  .brand-mark { font-family: Impact, sans-serif; font-style: italic; font-size: 2.6rem; line-height: 1;
    color: hsl(130,60%,32%); user-select: none; }
  .brand-name { font-weight: 800; font-size: 1rem; letter-spacing: 0.02em; }
  .brand-tag { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 0.95rem; color: var(--gray); }
  .role-pill { display: inline-block; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    padding: 0.3rem 0.75rem; border-radius: 999px; background: rgba(34,139,34,0.12); color: var(--green);
    border: 1px solid rgba(34,139,34,0.3); margin-bottom: 0.7rem; }
  .doc-head h1 { font-weight: 800; font-size: clamp(1.7rem, 4.5vw, 2.4rem); letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 0.6rem; }
  .doc-head p { font-family: 'Cormorant Garamond', serif; font-size: 1.08rem; color: #555; line-height: 1.55; max-width: 640px; }

  .doc-body { padding: 0.6rem 2.2rem 2rem; }
  .sec { padding-top: 1.6rem; }
  .sec-title { font-weight: 800; font-size: 1.05rem; color: var(--green); padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.08); margin-bottom: 1rem; }
  .sec-hint { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 0.98rem; color: var(--gray); margin: -0.4rem 0 0.9rem; }

  label.fl { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #555; font-weight: 700; }
  .req { color: var(--green); margin-left: 2px; }
  .opt { color: #aaa; margin-left: 4px; font-weight: 700; letter-spacing: 0.05em; text-transform: none; font-size: 0.6rem; }
  .fg { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; min-width: 0; }
  .row { display: grid; gap: 0.9rem; }
  .row.c2 { grid-template-columns: 1fr 1fr; }
  .row.c3 { grid-template-columns: 1fr 1fr 1fr; }
  .row.phone { grid-template-columns: 1.3fr 0.9fr 1.1fr; }
  input[type=text], input[type=email], input[type=tel], textarea, select {
    background: #fafafa; border: 1.5px solid #e2e2e2; border-radius: 3px; color: var(--dark);
    font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; padding: 0.6rem 0.8rem; outline: none;
    transition: border-color 0.3s, box-shadow 0.3s, background 0.3s; width: 100%;
  }
  input::placeholder, textarea::placeholder { color: #bbb; }
  input:focus, textarea:focus, select:focus { border-color: var(--green); background: #fff; box-shadow: 0 0 0 3px rgba(34,139,34,0.09); }
  .error { border-color: #e53935 !important; box-shadow: 0 0 0 3px rgba(229,57,53,0.07) !important; }
  .ferr { font-size: 0.68rem; color: #e53935; display: none; }
  .ferr.show { display: block; }
  textarea { resize: vertical; min-height: 120px; line-height: 1.5; }

  /* Checkbox grids */
  .check-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem 1rem; }
  .check-grid.c2 { grid-template-columns: repeat(2, 1fr); }
  .chk { display: flex; align-items: center; gap: 0.6rem; cursor: pointer; padding: 0.45rem 0.6rem;
    border: 1.5px solid transparent; border-radius: 4px; transition: background 0.2s, border-color 0.2s; }
  .chk:hover { background: rgba(34,139,34,0.05); }
  .chk input { appearance: none; -webkit-appearance: none; width: 18px; height: 18px; flex-shrink: 0;
    border: 1.5px solid #c9c9c9; border-radius: 3px; background: #fafafa; cursor: pointer; position: relative; transition: all 0.2s; }
  .chk input:checked { background: var(--green); border-color: var(--green); }
  .chk input:checked::after { content: ''; position: absolute; left: 5px; top: 1px; width: 5px; height: 10px;
    border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .chk input:focus-visible { box-shadow: 0 0 0 3px rgba(34,139,34,0.2); }
  .chk span { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; color: #333; line-height: 1.2; }
  .chk.on { background: rgba(34,139,34,0.06); border-color: rgba(34,139,34,0.2); }
  .check-grid.error { border-radius: 4px; }

  .skill-group { border: 1px solid rgba(0,0,0,0.07); border-radius: 8px; padding: 0.9rem 1rem 0.7rem; margin-bottom: 0.8rem; transition: border-color 0.2s, background 0.2s; }
  .skill-group.active { border-color: rgba(34,139,34,0.35); background: rgba(34,139,34,0.025); }
  .skill-group h4 { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #444; margin-bottom: 0.4rem; }
  .skill-group.active h4 { color: var(--green); }
  .skills-cols { columns: 2; column-gap: 0.9rem; }
  .skills-cols .skill-group { break-inside: avoid; display: inline-block; width: 100%; }

  .submit-bar { margin-top: 1.8rem; padding-top: 1.4rem; border-top: 1px solid rgba(0,0,0,0.08); }
  .msg { border-radius: 3px; padding: 0.7rem 0.85rem; font-size: 0.95rem; font-family: 'Cormorant Garamond', serif;
    line-height: 1.45; margin-bottom: 1rem; display: none; background: rgba(229,57,53,0.08); border: 1px solid rgba(229,57,53,0.25); color: #c62828; }
  .msg.show { display: block; }
  .submit-btn {
    width: 100%; padding: 1rem; background: var(--green); border: none; border-radius: 3px; color: #fff;
    font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.82rem; letter-spacing: 0.25em;
    text-transform: uppercase; cursor: pointer; transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
  }
  .submit-btn:hover:not(:disabled) { background: hsl(130,55%,34%); box-shadow: 0 4px 16px rgba(34,139,34,0.25); transform: translateY(-1px); }
  .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .submit-note { font-family: 'Cormorant Garamond', serif; font-size: 0.95rem; color: var(--gray); text-align: center; margin-top: 0.7rem; line-height: 1.45; }

  .doc-foot { border-top: 2px solid var(--green); padding: 1rem 2.2rem 1.3rem; text-align: center;
    font-family: 'Cormorant Garamond', serif; font-size: 0.92rem; color: #555; line-height: 1.5; }
  .doc-foot a { color: var(--green); text-decoration: none; }

  /* Send modal */
  .overlay { position: fixed; inset: 0; z-index: 70; display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.35s ease;
    background: rgba(235,240,235,0.75); backdrop-filter: blur(8px); padding: 1rem; }
  .overlay.show { opacity: 1; pointer-events: all; }
  .glass { background: #fff; border: 1px solid rgba(0,0,0,0.07); border-radius: 10px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.14); padding: clamp(1.5rem, 4vw, 2.3rem);
    width: min(520px, 96vw); max-height: 92vh; overflow-y: auto; position: relative;
    transform: translateY(16px); transition: transform 0.35s ease; }
  .overlay.show .glass { transform: translateY(0); }
  .close-btn { position: absolute; top: 0.9rem; right: 1.1rem; background: none; border: none; color: #aaa;
    cursor: pointer; font-size: 1.3rem; line-height: 1; }
  .close-btn:hover { color: var(--dark); }
  .glass .ico { width: 46px; height: 46px; border-radius: 50%; background: rgba(34,139,34,0.12); color: var(--green);
    display: flex; align-items: center; justify-content: center; margin-bottom: 0.9rem; }
  .glass h2 { font-weight: 800; font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: 0.4rem; }
  .glass h2 span { color: var(--green); }
  .glass p.lead { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; color: #555; line-height: 1.5; margin-bottom: 1.1rem; }
  .send-meta { background: #f6f8f5; border: 1px solid rgba(0,0,0,0.06); border-radius: 6px; padding: 0.8rem 0.95rem; margin-bottom: 1.1rem;
    font-size: 0.8rem; line-height: 1.7; word-break: break-word; }
  .send-meta b { display: inline-block; min-width: 64px; color: #666; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .attach-step { display: flex; gap: 0.6rem; align-items: flex-start; background: rgba(196,125,0,0.08);
    border: 1px solid rgba(196,125,0,0.25); border-radius: 6px; padding: 0.7rem 0.85rem; margin-bottom: 1.1rem;
    font-family: 'Cormorant Garamond', serif; font-size: 1rem; color: #6b4700; line-height: 1.45; }
  .btn-stack { display: flex; flex-direction: column; gap: 0.55rem; }
  .btn { display: flex; align-items: center; justify-content: center; gap: 0.55rem; width: 100%;
    padding: 0.85rem; border-radius: 3px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.72rem;
    letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; text-decoration: none; transition: all 0.25s; }
  .btn.primary { background: var(--green); color: #fff; border: 1.5px solid var(--green); }
  .btn.primary:hover { background: hsl(130,55%,34%); }
  .btn.ghost { background: #fff; color: var(--dark); border: 1.5px solid rgba(0,0,0,0.14); }
  .btn.ghost:hover { border-color: var(--green); color: var(--green); }
  .btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.55rem; }
  .btn svg { width: 16px; height: 16px; flex-shrink: 0; }

  @media (max-width: 640px) {
    .topbar { padding: 0.9rem 1rem; }
    .back-link span.lbl { display: none; }
    .doc-head, .doc-body, .doc-foot { padding-left: 1.1rem; padding-right: 1.1rem; }
    .row.c2, .row.c3, .row.phone { grid-template-columns: 1fr; gap: 0; }
    .check-grid { grid-template-columns: 1fr 1fr; }
    .skills-cols { columns: 1; }
    .btn-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 380px) { .check-grid, .check-grid.c2 { grid-template-columns: 1fr; } }
</style>
</head>
